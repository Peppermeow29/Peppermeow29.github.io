---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPosts, postPath } from '../../lib/posts'
import { formatDate } from '../../lib/formatDate'
import { withBase } from '../../lib/url'
import { ArrowUpRight, Search } from 'lucide-astro'

const posts = await getPosts()

function searchable(post: (typeof posts)[number]) {
  return [post.data.title, post.data.description, post.data.category, ...post.data.tags]
    .join(' ')
    .toLowerCase()
}
---

<BaseLayout title="文章" description="按照时间整理的全部文章，涵盖工程、部署、写作与产品观察。">
  <section class="page-intro archive-intro">
    <div>
      <p class="eyebrow">Knowledge archive / {String(posts.length).padStart(2, '0')}</p>
      <h1>文章归档<span class="title-dot">.</span></h1>
      <p>按时间整理的技术实践与思考。每一篇都始于一个真实问题，止于一套可复用的方法。</p>
    </div>
    <span class="page-code" aria-hidden="true">/ARTICLES</span>
  </section>

  <section class="toolbar">
    <Search size={18} />
    <input
      id="post-search"
      type="search"
      placeholder="搜索标题、标签或分类"
      autocomplete="off"
      aria-label="搜索文章"
    />
  </section>

  <section class="article-list" aria-label="文章列表">
    {
      posts.map((post, index) => (
        <article class="article-row" data-search={searchable(post)}>
          <div class="article-date">
            <span class="article-number">{String(index + 1).padStart(2, '0')}</span>
            <span>{formatDate(post.data.date)}</span>
            <strong>{post.data.category}</strong>
          </div>

          <div class="article-summary">
            <a href={withBase(postPath(post))}>
              <h2>{post.data.title}</h2>
            </a>
            <p>{post.data.description}</p>
            <div class="tag-list">
              {post.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>

          <a
            class="row-action"
            href={withBase(postPath(post))}
            aria-label={`打开《${post.data.title}》`}
          >
            <span class="row-action-label">阅读全文</span>
            <ArrowUpRight size={19} />
          </a>
        </article>
      ))
    }

    <div class="empty-state" id="search-empty" hidden>没有找到匹配的文章。</div>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#post-search')
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.article-row[data-search]'))
  const empty = document.querySelector<HTMLElement>('#search-empty')

  if (input) {
    input.addEventListener('input', () => {
      const keyword = input.value.trim().toLowerCase()
      let visible = 0

      for (const row of rows) {
        const hit = keyword === '' || (row.dataset.search ?? '').includes(keyword)
        row.hidden = !hit
        if (hit) visible += 1
      }

      if (empty) empty.hidden = visible > 0
    })
  }
</script>
