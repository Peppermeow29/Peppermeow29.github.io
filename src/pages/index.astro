---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import TechFeed from '../components/TechFeed.astro'
import { getPosts, postPath } from '../lib/posts'
import { getDigests, formatArchiveDate, FEED_PAGE_SIZE, ARCHIVE_SIZE } from '../lib/feed'
import { formatDate } from '../lib/formatDate'
import { withBase } from '../lib/url'
import { ArrowRight, ArrowUpRight, Rss } from 'lucide-astro'

const posts = await getPosts()
const featured = posts.find((post) => post.data.featured) ?? posts[0]
const recent = posts.filter((post) => post.id !== featured?.id).slice(0, 3)
const digests = getDigests()
const latest = digests[0]
const archive = digests.slice(0, ARCHIVE_SIZE)
const latestItems = latest ? latest.items.slice(0, FEED_PAGE_SIZE) : []
---

<BaseLayout>
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">Z.Coding · Personal Blog</p>
      <h1>记录技术，<br /><span>也记录思考。</span></h1>
      <p class="hero-lede">
        关于工程、工具与产品的独立博客。<br class="desktop-break" />把复杂问题讲清楚，把实践经验留下来。
      </p>
      <div class="hero-actions">
        <a class="primary-action" href={withBase('/articles/')}>
          开始阅读
          <ArrowRight size={17} />
        </a>
        <a class="secondary-action" href={withBase('/about/')}>关于作者</a>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="featured-section" aria-labelledby="featured-heading">
        <div class="section-header">
          <div>
            <p class="eyebrow">Featured</p>
            <h2 id="featured-heading">精选文章</h2>
          </div>
          <a class="text-link" href={withBase('/articles/')}>
            全部文章
            <ArrowRight size={15} />
          </a>
        </div>
        <article class="featured-panel">
          <a
            class="featured-visual"
            href={withBase(postPath(featured))}
            aria-label={`阅读《${featured.data.title}》`}
          >
            {featured.data.cover && (
              <Image
                src={featured.data.cover}
                alt={featured.data.coverAlt ?? featured.data.title}
                widths={[640, 960]}
                sizes="(max-width: 760px) 100vw, 52vw"
                loading="eager"
              />
            )}
          </a>
          <div class="featured-content">
            <span class="category-pill">{featured.data.category}</span>
            <h3><a href={withBase(postPath(featured))}>{featured.data.title}</a></h3>
            <p>{featured.data.description}</p>
            <div class="post-meta">
              <span>{formatDate(featured.data.date)}</span>
              <span>{featured.data.readingTime}</span>
            </div>
            <a class="text-link" href={withBase(postPath(featured))}>
              阅读全文
              <ArrowUpRight size={16} />
            </a>
          </div>
        </article>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="content-section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Latest writing</p>
            <h2>最近更新</h2>
          </div>
          <a class="text-link" href={withBase('/articles/')}>
            查看全部
            <ArrowRight size={15} />
          </a>
        </div>
        <div class="post-grid">
          {recent.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )
  }

  {
    latest && (
      <section class="content-section feed-section">
        <div class="section-header feed-heading">
          <div>
            <p class="eyebrow">Frontier feed</p>
            <h2>前沿速递</h2>
            <p class="section-note">聚合值得关注的技术动态，按日期整理，每天更新。</p>
          </div>
          <nav class="feed-archive" aria-label="按日期浏览速递">
            {archive.map((digest) => (
              <a
                href={withBase(`/digest/${digest.date}/`)}
                class:list={[{ active: digest.date === latest.date }]}
              >
                <strong>{formatArchiveDate(digest.date)}</strong>
                <span>{digest.items.length} 条</span>
              </a>
            ))}
          </nav>
        </div>
        <TechFeed items={latestItems} />
      </section>
    )
  }

  <section class="journal-band">
    <div class="journal-copy">
      <p class="eyebrow">Stay curious</p>
      <h2>持续写作，持续更新。</h2>
    </div>
    <p>前端工程、部署实践、论文与项目复盘，以及对产品界面和知识管理的观察。</p>
    <a href={withBase('/rss.xml')} class="journal-link"><Rss size={16} /> 订阅 RSS</a>
  </section>
</BaseLayout>
