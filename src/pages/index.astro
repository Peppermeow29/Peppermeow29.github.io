---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { getPosts, postPath } from '../lib/posts'
import { formatDate } from '../lib/formatDate'
import { withBase } from '../lib/url'
import { ArrowRight, BookOpen, Sparkles } from 'lucide-astro'

const posts = await getPosts()
const featured = posts.find((post) => post.data.featured) ?? posts[0]
const recent = posts.filter((post) => post.id !== featured?.id).slice(0, 3)
---

<BaseLayout>
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">Personal notes on code, design, and writing</p>
      <h1>一个安静、清晰、适合长期写作的个人博客。</h1>
      <p class="hero-lede">
        记录工程实践、产品观察和那些值得慢慢沉淀的想法。文章以 Markdown 编写，由 Astro 构建，发布在 GitHub Pages。
      </p>
      <div class="hero-actions">
        <a class="primary-action" href={withBase('/articles/')}>
          阅读文章
          <ArrowRight size={18} />
        </a>
        <a class="secondary-action" href={withBase('/about/')}>关于我</a>
      </div>
    </div>

    {
      featured && (
        <aside class="featured-panel" aria-label="推荐文章">
          <div class="panel-topline">
            <span>Featured</span>
            <Sparkles size={18} />
          </div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <div class="post-meta">
            <span>{formatDate(featured.data.date)}</span>
            <span>{featured.data.readingTime}</span>
          </div>
          <a class="text-link" href={withBase(postPath(featured))}>
            打开文章
            <ArrowRight size={16} />
          </a>
        </aside>
      )
    }
  </section>

  {
    recent.length > 0 && (
      <section class="section-grid">
        <div class="section-heading">
          <p class="eyebrow">Latest writing</p>
          <h2>最近更新</h2>
        </div>

        <div class="post-grid">
          {recent.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )
  }

  <section class="journal-band">
    <div>
      <BookOpen size={24} />
      <h2>写作方向</h2>
    </div>
    <p>这里会持续整理前端工程、部署实践、论文与项目复盘，以及对产品界面和知识管理的观察。</p>
  </section>
</BaseLayout>
