---
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { withBase } from '../lib/url'
import '../styles/main.css'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  publishedTime?: Date
  updatedTime?: Date
  noindex?: boolean
}

const {
  title,
  description = 'Z.Coding Blog — 记录工程、写作和长期思考的个人博客。',
  image,
  type = 'website',
  publishedTime,
  updatedTime,
  noindex = false,
} = Astro.props

const siteName = 'Z.Coding Blog'
const pageTitle = title ? `${title} · ${siteName}` : siteName
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = image ? new URL(image, Astro.site).href : undefined
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={withBase('/rss.xml')}
    />
    <meta name="theme-color" content="#f6f1e8" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={title ?? siteName} />}
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-shell">
      <SiteHeader pathname={Astro.url.pathname} />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
